# Personal development settings for FUDISLTE. Copy to ~/.config/fudislte/dev.env inside WSL
# (never into the repository). Lines starting with # are ignored.
#
# To deliver real email instead of printing it to the API log, fill in ONE of the
# provider blocks below, then remove the # in front of the next line. Until then the
# API keeps printing emails (sign-in codes) to its log.

# FUDISLTE_MAIL_TRANSPORT=smtp

# --- Generic / your company's mail server -------------------------------------------
FUDISLTE_SMTP_HOST=smtp.company.com
FUDISLTE_SMTP_PORT=587
FUDISLTE_SMTP_TLS=starttls
FUDISLTE_SMTP_USERNAME=fudislte@company.com
FUDISLTE_SMTP_PASSWORD=
FUDISLTE_SMTP_FROM="FUDISLTE <fudislte@company.com>"

# --- Gmail / Google Workspace (needs 2-step verification and an App Password) --------
# FUDISLTE_SMTP_HOST=smtp.gmail.com
# FUDISLTE_SMTP_PORT=587
# FUDISLTE_SMTP_TLS=starttls
# FUDISLTE_SMTP_USERNAME=you@gmail.com
# FUDISLTE_SMTP_PASSWORD=<16-character app password, no spaces>
# FUDISLTE_SMTP_FROM="FUDISLTE <you@gmail.com>"

# --- Microsoft 365 (SMTP AUTH must be enabled for the mailbox) -----------------------
# FUDISLTE_SMTP_HOST=smtp.office365.com
# FUDISLTE_SMTP_PORT=587
# FUDISLTE_SMTP_TLS=starttls
# FUDISLTE_SMTP_USERNAME=you@company.com
# FUDISLTE_SMTP_PASSWORD=
# FUDISLTE_SMTP_FROM="FUDISLTE <you@company.com>"

# --- Yandex Mail (needs an app password) ---------------------------------------------
# FUDISLTE_SMTP_HOST=smtp.yandex.com
# FUDISLTE_SMTP_PORT=465
# FUDISLTE_SMTP_TLS=tls
# FUDISLTE_SMTP_USERNAME=you@yandex.com
# FUDISLTE_SMTP_PASSWORD=<app password>
# FUDISLTE_SMTP_FROM="FUDISLTE <you@yandex.com>"
