# Public DNS name that points at this server. Caddy obtains a TLS certificate for it.
FUDISLTE_DOMAIN=fudislte.example.com

# Database password. Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Outgoing email. People sign in with one-time codes sent to their work address, so
# FUDISLTE needs an SMTP relay: your mail server, Microsoft 365 / Google Workspace relay,
# or a transactional provider. Port 587 + starttls or port 465 + tls.
FUDISLTE_SMTP_HOST=
FUDISLTE_SMTP_PORT=587
FUDISLTE_SMTP_TLS=starttls
FUDISLTE_SMTP_USERNAME=
FUDISLTE_SMTP_PASSWORD=
FUDISLTE_SMTP_FROM="FUDISLTE <fudislte@example.com>"

# Optional fixed first-run setup token (at least 16 characters). When empty, a one-time
# token is printed by `docker compose logs api` until setup is completed.
FUDISLTE_SETUP_TOKEN=

# Voice and video (optional, docs/decisions/0011): start the stack with
# COMPOSE_PROFILES=media to run LiveKit beside FUDISLTE. Generate the key and secret with
#   echo "API$(openssl rand -hex 6)"   and   openssl rand -hex 24
# and open ports 7881/tcp, 7882/udp and 3478/udp in the firewall.
COMPOSE_PROFILES=
FUDISLTE_LIVEKIT_URL=
FUDISLTE_LIVEKIT_API_KEY=
FUDISLTE_LIVEKIT_API_SECRET=
# The server's public IP when LiveKit cannot discover it (private networks, NAT).
FUDISLTE_LIVEKIT_NODE_IP=

# AI assistant (optional, docs/decisions/0012): run with the compose.ai.yml overlay.
# Generate both with: openssl rand -hex 32. Model settings: docs/architecture/ai-worker.md.
FUDISLTE_AI_SHARED_SECRET=
FUDISLTE_AI_POSTGRES_PASSWORD=

# Image tag for locally built images.
FUDISLTE_VERSION=0.1.1
