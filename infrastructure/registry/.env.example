# Public DNS name that points at this server, for example registry.example.org.
# Caddy obtains a TLS certificate for it; ports 80 and 443 must be reachable.
REGISTRY_DOMAIN=registry.example.org

# Password for the list page (any user name works). At least 12 characters; generate
# one with: openssl rand -base64 24
FUDISLTE_REGISTRY_ADMIN_PASSWORD=
