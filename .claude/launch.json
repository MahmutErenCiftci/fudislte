{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@fudislte/web", "dev"],
      "port": 5173
    },
    {
      "name": "website",
      "runtimeExecutable": "wsl",
      "runtimeArgs": ["-d", "Ubuntu-24.04", "--", "python3", "-m", "http.server", "8000", "--bind", "127.0.0.1", "--directory", "website"],
      "port": 8000
    },
    {
      "name": "api-alt",
      "runtimeExecutable": "wsl",
      "runtimeArgs": [
        "-d", "Ubuntu-24.04", "--", "env",
        "PGPORT=5433",
        "FUDISLTE_HTTP_ADDR=127.0.0.1:8091",
        "FUDISLTE_DATABASE_URL=postgres://fudislte:fudislte@localhost:5433/fudislte?sslmode=disable",
        "FUDISLTE_PUBLIC_URL=http://localhost:5174",
        "bash", "scripts/wsl/dev-api.sh"
      ],
      "port": 8091
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@fudislte/web", "exec", "vite", "--port", "5174", "--strictPort"],
      "env": { "FUDISLTE_API_URL": "http://127.0.0.1:8091" },
      "port": 5174
    }
  ]
}
